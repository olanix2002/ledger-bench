+import { beforeEach, describe, expect, it } from "vitest";
+import request from "supertest";
+import { openDb, type DB } from "../src/db.js";
+import { createApp } from "../src/app.js";
+
+let db: DB;
+let app: ReturnType<typeof createApp>;
+
+beforeEach(() => {
+  db = openDb();
+  app = createApp(db);
+});
+
+async function mk(owner: string, cents: number) {
+  const response = await request(app).post("/accounts").send({ owner, initial_balance_cents: cents });
+  return response.body as { id: string; balance_cents: number };
+}
+
+describe("transfer idempotency", () => {
+  it("returns the original transfer for a repeated key and body", async () => {
+    const source = await mk("ada", 1000);
+    const destination = await mk("bola", 0);
+    const body = { from_account: source.id, to_account: destination.id, amount_cents: 400 };
+
+    const first = await request(app).post("/transfers").set("Idempotency-Key", "payment-1").send(body);
+    const retry = await request(app).post("/transfers").set("Idempotency-Key", "payment-1").send(body);
+
+    expect(first.status).toBe(201);
+    expect(retry.status).toBe(first.status);
+    expect(retry.body).toEqual(first.body);
+    expect((await request(app).get(`/accounts/${source.id}`)).body.balance_cents).toBe(600);
+    expect((await request(app).get(`/accounts/${destination.id}`)).body.balance_cents).toBe(400);
+  });
+
+  it("rejects reusing a key with a different destination or amount", async () => {
+    const source = await mk("ada", 1000);
+    const destination = await mk("bola", 0);
+    const otherDestination = await mk("chen", 0);
+    const key = "payment-1";
+
+    const first = await request(app)
+      .post("/transfers")
+      .set("Idempotency-Key", key)
+      .send({ from_account: source.id, to_account: destination.id, amount_cents: 200 });
+    const differentAmount = await request(app)
+      .post("/transfers")
+      .set("Idempotency-Key", key)
+      .send({ from_account: source.id, to_account: destination.id, amount_cents: 300 });
+    const differentDestination = await request(app)
+      .post("/transfers")
+      .set("Idempotency-Key", key)
+      .send({ from_account: source.id, to_account: otherDestination.id, amount_cents: 200 });
+
+    expect(first.status).toBe(201);
+    expect(differentAmount.status).toBe(409);
+    expect(differentDestination.status).toBe(409);
+    expect((await request(app).get(`/accounts/${source.id}`)).body.balance_cents).toBe(800);
+    expect((await request(app).get(`/accounts/${destination.id}`)).body.balance_cents).toBe(200);
+    expect((await request(app).get(`/accounts/${otherDestination.id}`)).body.balance_cents).toBe(0);
+  });
+
+  it("does not reserve a key when the first attempt fails", async () => {
+    const source = await mk("ada", 50);
+    const destination = await mk("bola", 0);
+    const body = { from_account: source.id, to_account: destination.id, amount_cents: 100 };
+
+    const failed = await request(app).post("/transfers").set("Idempotency-Key", "payment-1").send(body);
+    db.prepare("UPDATE accounts SET balance_cents = 150 WHERE id = ?").run(source.id);
+    const retry = await request(app).post("/transfers").set("Idempotency-Key", "payment-1").send(body);
+
+    expect(failed.status).toBe(409);
+    expect(retry.status).toBe(201);
+    expect((await request(app).get(`/accounts/${source.id}`)).body.balance_cents).toBe(50);
+    expect((await request(app).get(`/accounts/${destination.id}`)).body.balance_cents).toBe(100);
+  });
+
+  it("scopes keys to the source account", async () => {
+    const sourceA = await mk("ada", 300);
+    const sourceB = await mk("bela", 300);
+    const destination = await mk("chen", 0);
+    const body = (source: string) => ({ from_account: source, to_account: destination.id, amount_cents: 200 });
+
+    const first = await request(app).post("/transfers").set("Idempotency-Key", "shared-key").send(body(sourceA.id));
+    const second = await request(app).post("/transfers").set("Idempotency-Key", "shared-key").send(body(sourceB.id));
+
+    expect(first.status).toBe(201);
+    expect(second.status).toBe(201);
+    expect((await request(app).get(`/accounts/${sourceA.id}`)).body.balance_cents).toBe(100);
+    expect((await request(app).get(`/accounts/${sourceB.id}`)).body.balance_cents).toBe(100);
+    expect((await request(app).get(`/accounts/${destination.id}/transfers`)).body).toHaveLength(2);
+  });
+});
